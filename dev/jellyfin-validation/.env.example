# Copy to .env in this directory and edit. Compose reads .env from the directory that
# holds the compose file, so nothing here needs exporting in your shell. Every value
# below is already the default; the file exists so the knobs are in one place.
#
# .env files are ignored by git, so nothing you set here can be committed by accident.

# --- Inputs the run reads -------------------------------------------------------------
# The plugin assembly the server loads. This is the file the CI build leaves behind; the
# archive artifacts/Anaglyfin_<version>.zip contains exactly this DLL, so either one is
# a valid source once unpacked.
HARNESS_PLUGIN_DLL=../../src/Anaglyfin/bin/Release/net10.0/Anaglyfin.dll

# The self-contained linux-x64 wrapper, as staged by the CI packaging job.
HARNESS_WRAPPER_BIN=../../artifacts/anaglyfin-ffmpeg

# The check script the wrapper-check service mounts; only worth naming when the daemon
# sees this directory under another path (see the split-path note at the bottom).
HARNESS_CHECK_SCRIPT=./wrapper-check.sh

# Optional: an FFmpeg-mvc build for the converted profiles to actually decode MVC. The
# harness does not mount one by default - see README.md step 9 for both halves.
# HARNESS_FFMPEG_MVC=/path/to/ffmpeg-mvc-n8.1.2-mvc8-jf5

# --- Mount shape of the real server ---------------------------------------------------
# Relative paths resolve against this directory. Point these at your own directories to
# reuse a real library or a real config; leave them alone for a disposable run.
HARNESS_CONFIG_DIR=./jellyfin/config
HARNESS_CACHE_DIR=./jellyfin/cache
HARNESS_MEDIA_DIR=./media

# --- The image and the port ----------------------------------------------------------
# The pinned current target runtime: Jellyfin 12.1. Pinning keeps a run recorded against 12.1
# from silently drifting to whatever `:latest` has become. Set this to float the tag, or to a
# digest for a byte-identical rerun.
HARNESS_IMAGE=jellyfin/jellyfin:12.1
HARNESS_WEB_PORT=8096

# --- Wrapper environment, as seen INSIDE the container --------------------------------
# The server's FFmpeg path: where the wrapper is mounted. Do not point this at the real
# FFmpeg; the whole run is about the wrapper being in the middle.
HARNESS_JELLYFIN_FFMPEG=/config/anaglyfin/ffmpeg/anaglyfin-ffmpeg

# What the wrapper hands MARKER/PROFILE commands to. The default is the FFmpeg the official
# image ships - enough for marker transport, rewrite, and pass-through checks, NOT enough to
# decode MVC. For real 3D output, mount an FFmpeg-mvc build and point this at its path inside
# the container; README.md step 3b shows both halves. (ffprobe beside the wrapper stays the
# OFFICIAL one - see `sh harness.sh ffprobe` - not the FFmpeg-mvc build's.)
HARNESS_REAL_FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg

# What the wrapper hands ORDINARY commands and the server's startup capability probes to - the
# stock FFmpeg the server would otherwise run. Matches the official image's FFmpeg by default,
# so ordinary playback runs on the same binary a real two-binary deployment would use. Unset or
# blank reverts to single-binary behaviour (ordinary commands also go to HARNESS_REAL_FFMPEG).
HARNESS_SERVER_FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg

# Slot files are runtime state, so they live in the container's tmp. Keep one value for
# every wrapper process that is supposed to share a single limit.
HARNESS_LOCK_DIR=/tmp/anaglyfin/ffmpeg-wrapper
HARNESS_MAX_CONCURRENT_TRANSCODES=1

# --- Only when the daemon and this shell see different paths --------------------------
# A bind mount's source is read by the Docker DAEMON. When the daemon lives elsewhere -
# an agent container over the host's daemon, a remote daemon, a VM - it sees this
# checkout under another mount point, and the paths above have to be written the way the
# DAEMON sees them. The two prefixes exist so harness.sh can translate them back for its
# own file checks; leave both unset when the two views are the same, which is the normal
# case. README.md step 3 has the worked example.
# HARNESS_DAEMON_PREFIX=/mnt/workspace/Anaglyfin/.worktrees/agent-T10
# HARNESS_LOCAL_PREFIX=/workspace/Anaglyfin/.worktrees/agent-T10
