# The CI image installs the toolchain only: sources arrive through the bind
# mount at run time, so nothing below ever needs to reach the build context.
# Keeping the context small also stops large local trees (vendor checkouts,
# sibling agent worktrees, build output) from being uploaded on `docker build`.
**/bin/**
**/obj/**
**/artifacts/**
**/TestResults/**
.git/
.worktrees/
.shared/
.logs/

# Local 3D test media, ignored by git and far too large for a build context.
/movies/
**/movies/

# The runtime-validation harness keeps a disposable Jellyfin server, its library mount,
# and captured evidence bundles here. The compose file and scripts belong to the image
# build only as text; everything a run writes stays out of the context - including a run
# that points its state at a sibling directory of its own (jellyfin-t11/, media-sp2/).
/dev/jellyfin-validation/jellyfin/
/dev/jellyfin-validation/jellyfin*/
/dev/jellyfin-validation/media/
/dev/jellyfin-validation/media*/
/dev/jellyfin-validation/collect/
/dev/jellyfin-validation/collect*/
