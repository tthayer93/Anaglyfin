# Orchestrator / agent workspace state (never part of the product tree)
.worktrees/
.shared/
.logs/

# Local-only compose launch overrides (the CI job takes SRC_DIR from the caller)
.env
.env.local

# Local 3D test media used for manual runs; never part of the repository
/movies/

# Disposable Jellyfin validation harness state: a throwaway server config/cache, the
# media mounted into it, and the evidence bundles `harness.sh collect` writes. A run is
# free to point HARNESS_CONFIG_DIR / HARNESS_MEDIA_DIR at a sibling directory of its own
# (jellyfin-t11/, media-sp2/, collect-rerun/ and friends), so none of that shape is
# allowed to reach the index either.
/dev/jellyfin-validation/jellyfin/
/dev/jellyfin-validation/jellyfin*/
/dev/jellyfin-validation/media/
/dev/jellyfin-validation/media*/
/dev/jellyfin-validation/collect/
/dev/jellyfin-validation/collect*/

# .NET build output
bin/
obj/
artifacts/
TestResults/
*.binlog
*.trx
*.coverage
coverage*.xml

# IDE / editor
.vs/
.vscode/
.idea/
*.user
*.suo

# OS noise
.DS_Store
Thumbs.db
